# Copy this file to .env and fill only the providers you use.

BINGO_OPENAI_API_BASE=https://your-api.example/v1
BINGO_OPENAI_API_KEY=
BINGO_OPENAI_MODEL=gpt-5.4

BINGO_ANTHROPIC_API_BASE=https://www.right.codes/claude/v1
BINGO_ANTHROPIC_API_KEY=
BINGO_ANTHROPIC_MODEL=claude-sonnet-4-6

BINGO_DEEPSEEK_API_BASE=https://api.deepseek.com/anthropic
BINGO_DEEPSEEK_API_KEY=
BINGO_DEEPSEEK_MODEL=deepseek-v4-pro

# Code RAG embeddings are separate from the generative model.
# none = keyword fallback; fastembed = local multilingual ONNX model (pip install -e '.[rag]').
BINGO_EMBED_PROVIDER=none
BINGO_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Optional shared local model cache; default: <workspace>/.bingo/retrieval/models
# BINGO_EMBED_CACHE=D:/models/bingo-embeddings
# For Ollama: provider=ollama, model=embeddinggemma, URL=http://localhost:11434
# For OpenAI-compatible embeddings: provider=openai, model=text-embedding-3-small
# BINGO_EMBED_BASE_URL=https://api.openai.com/v1
# BINGO_EMBED_API_KEY=
BINGO_EMBED_TIMEOUT=15
BINGO_RETRIEVAL_MAX_EMBED_CHUNKS=256
BINGO_RETRIEVAL_SMALL_CHUNKS=200
BINGO_RETRIEVAL_LARGE_CHUNKS=5000
BINGO_RETRIEVAL_USE_ANN=1
# Weak ANN evidence falls back to exact cosine; calibrate for your embedding model.
BINGO_RETRIEVAL_ANN_MIN_SIMILARITY=0.55
